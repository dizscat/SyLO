<Window x:Class="SyLO.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SyLO"
        Title="SyLO — Pengaturan Overlay Lirik"
        Width="580" Height="780" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F6F6F9" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <local:ColorStringToBrushConverter x:Key="ToBrush"/>

        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Width" Value="190"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Width" Value="72"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#ECECF2" Padding="14,10" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Reset ke default" Padding="12,4" Margin="0,0,8,0" Click="Reset_Click"/>
                    <Button Content="Tutup" Padding="18,4" IsDefault="True" Click="Close_Click"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="#555" FontSize="12" TextWrapping="Wrap" Text="Pengaturan tersimpan otomatis."/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">

                <DockPanel Style="{StaticResource Row}" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Label}" Text="Bahasa / Language / 语言" FontWeight="SemiBold"/>
                    <ComboBox x:Name="LanguageBox" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Language}"/>
                </DockPanel>

                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                           Text="Overlay tidak bisa diklik — semua diatur dari sini. Selama jendela ini terbuka, overlay menampilkan pratinjau supaya kamu bisa lihat hasil perubahan langsung."/>

                <GroupBox Header="Template gaya &amp; posisi">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Simpan tampilan &amp; posisi sekarang sebagai template, lalu muat lagi kapan saja. Setiap template punya kode yang bisa dibagikan ke pengguna SyLO lain."/>

                        <ListBox x:Name="PresetList" Height="140" Margin="0,4"
                                 MouseDoubleClick="PresetList_DoubleClick" SelectionChanged="PresetList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#777" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyPresetsHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                                   Text="Belum ada template. Atur tampilan sesukamu, beri nama di bawah, lalu klik Simpan."/>

                        <WrapPanel Margin="0,2,0,6">
                            <Button x:Name="LoadBtn" Content="Muat" Padding="14,3" Margin="0,0,6,4" FontWeight="SemiBold" Click="LoadPreset_Click"/>
                            <Button x:Name="OverwriteBtn" Content="Timpa dengan pengaturan sekarang" Padding="8,3" Margin="0,0,6,4" Click="OverwritePreset_Click"/>
                            <Button x:Name="RenameBtn" Content="Ganti nama" Padding="8,3" Margin="0,0,6,4" Click="RenamePreset_Click"/>
                            <Button x:Name="CopyCodeBtn" Content="Salin kode" Padding="8,3" Margin="0,0,6,4" Click="CopyCode_Click"/>
                            <Button x:Name="DeleteBtn" Content="Hapus" Padding="8,3" Margin="0,0,6,4" Click="DeletePreset_Click"/>
                        </WrapPanel>

                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Content="Simpan sebagai template baru" Padding="8,3" Margin="6,0,0,0" Click="SavePreset_Click"/>
                            <TextBox x:Name="PresetNameBox" VerticalContentAlignment="Center" Padding="4,2"
                                     MaxLength="60" ToolTip="Nama template (dipakai juga untuk Ganti nama)"/>
                        </DockPanel>

                        <TextBlock Text="Punya kode template dari orang lain?" Margin="0,8,0,2" FontWeight="SemiBold"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Content="Impor &amp; pakai" Padding="8,3" Margin="6,0,0,0" Click="ImportCode_Click"/>
                            <TextBox x:Name="ImportBox" VerticalContentAlignment="Center" Padding="4,2" FontFamily="Consolas"
                                     ToolTip="Tempel kode SYLO1-… di sini"/>
                        </DockPanel>

                        <DockPanel Margin="0,4,0,0">
                            <Button x:Name="UndoBtn" DockPanel.Dock="Right" Content="↶ Urungkan muat terakhir" Padding="8,3" Click="Undo_Click"/>
                            <TextBlock x:Name="PresetStatus" VerticalAlignment="Center" Foreground="#2B7A3D" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Teks">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Font"/>
                            <ComboBox x:Name="FontBox" SelectedItem="{Binding FontFamily}">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Ukuran font"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding FontSize, StringFormat={}{0:0} px}"/>
                            <Slider Minimum="12" Maximum="96" Value="{Binding FontSize}" SmallChange="1" LargeChange="4"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Gaya"/>
                            <CheckBox Content="Huruf tebal (bold)" IsChecked="{Binding Bold}" Margin="0"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Warna lirik aktif"/>
                            <Button Style="{StaticResource Swatch}" Tag="TextColor" Click="PickColor">
                                <Border Background="{Binding TextColor, Converter={StaticResource ToBrush}}" BorderBrush="#888" BorderThickness="1" Width="96" Height="16"/>
                            </Button>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Warna baris lain"/>
                            <Button Style="{StaticResource Swatch}" Tag="OtherLinesColor" Click="PickColor">
                                <Border Background="{Binding OtherLinesColor, Converter={StaticResource ToBrush}}" BorderBrush="#888" BorderThickness="1" Width="96" Height="16"/>
                            </Button>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Warna outline"/>
                            <Button Style="{StaticResource Swatch}" Tag="OutlineColor" Click="PickColor">
                                <Border Background="{Binding OutlineColor, Converter={StaticResource ToBrush}}" BorderBrush="#888" BorderThickness="1" Width="96" Height="16"/>
                            </Button>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Ketebalan outline"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding OutlineThickness, StringFormat={}{0:0.0} px}"/>
                            <Slider Minimum="0" Maximum="8" Value="{Binding OutlineThickness}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Tampilan">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Gaya tampilan" FontWeight="SemiBold"/>
                            <ComboBox x:Name="StyleBox" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Style}"/>
                        </DockPanel>
                        <CheckBox Content="Animasi aktif (matikan kalau ingin teks langsung muncul tanpa gerakan)" IsChecked="{Binding Animate}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Sinematik &amp; Garis perspektif: satu baris muncul huruf demi huruf sambil mengambang. Pengaturan posisi &amp; jumlah baris tidak dipakai; lebar area = lebar maksimal satu baris."/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Garis perspektif (experimental): lirik ditulis di sepanjang garis yang menuju titik hilang wallpaper (pagar, rel, lorong), makin jauh makin kecil. Kalau garisnya tidak ditemukan, lirik tampil seperti Sinematik."/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Titik hilang perspektif"/>
                            <Button DockPanel.Dock="Right" Content="Buka editor perspektif…" Padding="8,3" Margin="6,0,0,0" Click="OpenPerspectiveEditor_Click"/>
                            <ComboBox x:Name="PerspectiveSourceBox" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding PerspectiveSource}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Di editor kamu bisa memilih perspektif 1, 2, 3, atau 4 titik, menyeret titik hilang di atas gambar wallpaper, menambah titik (sampai 6), dan melihat contoh lirik langsung."/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Kejelasan lirik (opacity)"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding LyricsOpacity, StringFormat={}{0:0%}}"/>
                            <Slider Minimum="0.1" Maximum="1" Value="{Binding LyricsOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Baris sebelumnya"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding LinesBefore}"/>
                            <Slider Minimum="0" Maximum="3" Value="{Binding LinesBefore}" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Baris berikutnya"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding LinesAfter}"/>
                            <Slider Minimum="0" Maximum="3" Value="{Binding LinesAfter}" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Kejelasan baris lain"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding OtherLinesOpacity, StringFormat={}{0:0%}}"/>
                            <Slider Minimum="0.1" Maximum="1" Value="{Binding OtherLinesOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Ukuran baris lain"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding OtherLinesScale, StringFormat={}{0:0%}}"/>
                            <Slider Minimum="0.4" Maximum="1" Value="{Binding OtherLinesScale}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Rata teks"/>
                            <ComboBox x:Name="AlignBox" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Align}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Warna latar"/>
                            <Button Style="{StaticResource Swatch}" Tag="BackgroundColor" Click="PickColor">
                                <Border Background="{Binding BackgroundColor, Converter={StaticResource ToBrush}}" BorderBrush="#888" BorderThickness="1" Width="96" Height="16"/>
                            </Button>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Kepekatan latar"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding BackgroundOpacity, StringFormat={}{0:0%}}"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="0% = tanpa latar (hanya teks ber-outline)."/>
                        <CheckBox Content="Tampilkan judul &amp; artis di atas lirik" IsChecked="{Binding ShowTrackInfo}"/>
                        <CheckBox Content="Sembunyikan overlay saat lagu di-pause" IsChecked="{Binding HideWhenPaused}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Sinematik">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Berlaku untuk gaya Sinematik dan Garis perspektif."/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Kecepatan munculnya huruf"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding RevealSpeed, StringFormat={}{0:0.00}x}"/>
                            <Slider Minimum="0.25" Maximum="4" Value="{Binding RevealSpeed}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Tampilkan lebih awal"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding CineLeadMs, StringFormat={}{0} ms}"/>
                            <Slider Minimum="0" Maximum="1500" Value="{Binding CineLeadMs}" TickFrequency="50" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Kalau kata pertama terasa telat, naikkan 'Tampilkan lebih awal' dan/atau kecepatan."/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Kekuatan cahaya (glow)"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding GlowStrength, StringFormat={}{0:0%}}"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding GlowStrength}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Ukuran cahaya"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding GlowSize, StringFormat={}{0:0} px}"/>
                            <Slider Minimum="0" Maximum="40" Value="{Binding GlowSize}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Warna cahaya dari"/>
                            <ComboBox x:Name="GlowSourceBox" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding GlowSource}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Warna cahaya (pilihan sendiri)"/>
                            <Button Style="{StaticResource Swatch}" Tag="GlowColor" Click="PickColor">
                                <Border Background="{Binding GlowColor, Converter={StaticResource ToBrush}}" BorderBrush="#888" BorderThickness="1" Width="96" Height="16"/>
                            </Button>
                        </DockPanel>
                        <CheckBox Content="Warna teks ikut warna cover album" IsChecked="{Binding AlbumColorText}"/>
                        <CheckBox Content="Lirik lewat di belakang objek wallpaper (tiang, karakter, dll.) (experimental)" IsChecked="{Binding Occlusion}" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Banyaknya objek di depan lirik"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding OcclusionStrength, StringFormat={}{0:0%}}"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding OcclusionStrength}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <Button x:Name="ModelBtn" DockPanel.Dock="Right" Content="Unduh model AI (±26 MB)" Padding="8,3" Click="DownloadModel_Click"/>
                            <TextBlock x:Name="ModelStatus" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Memakai model AI Depth Anything V2 Small (Apache-2.0) untuk menebak objek mana yang ada di depan. Hanya berlaku saat lirik berada di atas desktop; kalau di atas Word / game, lirik tampil utuh. Wallpaper dibaca dari bagian desktop yang sedang terlihat. Tips: matikan 'Hindari bagian menonjol' supaya lirik lebih sering lewat di belakang karakter."/>
                        <CheckBox Content="Hindari bagian menonjol wallpaper (Wallpaper Engine / wallpaper biasa)" IsChecked="{Binding AvoidWallpaperFocus}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Wallpaper dicek tiap ±3 detik; kalau berubah, warna cahaya ikut berubah saat itu juga. Lirik dipilihkan tempat yang paling sedikit menutupi karakter / objek utama (boleh lewat sedikit)."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Posisi">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Monitor"/>
                            <ComboBox x:Name="MonitorBox" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding MonitorIndex}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Posisi di layar"/>
                            <ComboBox x:Name="AnchorBox" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Anchor}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Geser kiri / kanan"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding OffsetX, StringFormat={}{0:0} px}"/>
                            <Slider Minimum="-1200" Maximum="1200" Value="{Binding OffsetX}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Geser atas / bawah"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding OffsetY, StringFormat={}{0:0} px}"/>
                            <Slider Minimum="-1200" Maximum="1200" Value="{Binding OffsetY}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Negatif = ke kiri / ke atas, positif = ke kanan / ke bawah."/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Lebar area lirik"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding WidthPercent, StringFormat={}{0:0}% layar}"/>
                            <Slider Minimum="15" Maximum="100" Value="{Binding WidthPercent}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <Button Content="Kembalikan geseran ke 0" HorizontalAlignment="Left" Padding="10,3" Margin="0,4,0,0" Click="ResetOffset_Click"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Sinkronisasi">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Geser waktu lirik"/>
                            <TextBlock Style="{StaticResource Val}" Text="{Binding SyncOffsetMs, StringFormat={}{0:+0;-0;0} ms}"/>
                            <Slider Minimum="-3000" Maximum="3000" Value="{Binding SyncOffsetMs}" TickFrequency="50" IsSnapToTickEnabled="True"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Positif = lirik muncul lebih cepat, negatif = lebih lambat. Saat main game bisa pakai Ctrl+Alt+[ dan Ctrl+Alt+] (±250 ms)."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Lainnya">
                    <StackPanel>
                        <CheckBox Content="Tampilkan overlay" IsChecked="{Binding OverlayVisible}"/>
                        <CheckBox Content="Jalankan SyLO otomatis saat Windows menyala" IsChecked="{Binding RunAtStartup}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Hotkey:&#x0a;Ctrl+Alt+L — tampilkan / sembunyikan overlay&#x0a;Ctrl+Alt+O — buka jendela pengaturan ini&#x0a;Ctrl+Alt+[ / Ctrl+Alt+] — lirik lebih lambat / lebih cepat"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Untuk game: pakai mode Borderless / Windowed. Mode Exclusive Fullscreen akan menutupi overlay."/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Sumber lirik: lrclib.net (komunitas). Tidak semua lagu tersedia."/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
